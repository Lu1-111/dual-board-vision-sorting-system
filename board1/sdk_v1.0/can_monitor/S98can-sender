#!/bin/sh
# Real telemetry only. Missing/stale data intentionally withholds heartbeats.
set -eu
BIN=/opt/can-monitor/can_sender
PIDFILE=/var/run/can-monitor-sender.pid
LOG=/var/log/can-monitor-sender.log
running() {
    test -r "$PIDFILE" || return 1
    PID=$(cat "$PIDFILE")
    case "$PID" in ''|*[!0-9]*) return 1;; esac
    test "$(readlink /proc/$PID/exe 2>/dev/null)" = "$BIN" || return 1
    ! grep -q '^State:.*Z' /proc/$PID/status 2>/dev/null
}
case "${1:-}" in
start)
    running && exit 0
    test -x "$BIN" || { echo 'CAN sender missing'; exit 1; }
    if [ -f "$LOG" ]; then mv "$LOG" "$LOG.previous"; fi
    "$BIN" --can can0 --state /run/line-state.txt --interval-ms 2000 >> "$LOG" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 0.3
    running || { echo 'CAN sender failed to start'; exit 1; }
    echo "Real CAN sender running: $PID (waiting for fresh /run/line-state.txt if absent)"
    ;;
stop)
    if running; then
        kill "$PID"
        n=0
        while running && [ "$n" -lt 30 ]; do sleep 0.1; n=$((n+1)); done
        if running; then echo 'CAN sender did not stop'; exit 1; fi
    fi
    rm -f "$PIDFILE"
    ;;
restart) "$0" stop; "$0" start ;;
status)
    if running; then echo "Real CAN sender running: $PID"; else echo 'CAN sender stopped'; exit 1; fi
    ;;
*) echo 'Usage: S98can-sender start|stop|restart|status'; exit 2 ;;
esac
