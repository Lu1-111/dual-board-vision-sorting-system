#!/bin/sh
# 测试图脚本可保留作为启动阶段画面，本服务随后启动交互界面。
PIDFILE=/var/run/monitor-ui.pid
running() {
    test -r "$PIDFILE" || return 1
    PID=$(cat "$PIDFILE")
    case "$PID" in ''|*[!0-9]*) return 1;; esac
    test "$(cat /proc/$PID/comm 2>/dev/null)" = monitor_ui || return 1
    ! grep -q '^State:.*Z' /proc/$PID/status 2>/dev/null
}
case "$1" in
  start)
    running && exit 0
    if [ -x /opt/monitor-ui/run_monitor_ui.sh ]; then
      if [ -x /opt/monitor-ui/prepare_monitor_can.sh ]; then
        /opt/monitor-ui/prepare_monitor_can.sh start || exit 1
      fi
      /opt/monitor-ui/run_monitor_ui.sh >> /var/log/monitor-ui.log 2>&1 &
      echo $! > "$PIDFILE"
      sleep 0.3
      if ! running; then
        /opt/monitor-ui/prepare_monitor_can.sh stop
        echo 'UI failed to start; inspect /var/log/monitor-ui.log'; exit 1
      fi
    fi
    ;;
  stop)
    if running; then
      kill "$PID"
      n=0
      while running && [ "$n" -lt 30 ]; do
        sleep 0.1
        n=$((n+1))
      done
      if running; then echo 'UI did not stop'; exit 1; fi
    fi
    rm -f "$PIDFILE"
    if [ -x /opt/monitor-ui/prepare_monitor_can.sh ]; then
      /opt/monitor-ui/prepare_monitor_can.sh stop || exit 1
    fi
    ;;
  restart)
    "$0" stop || exit 1
    "$0" start
    ;;
  status)
    if running; then echo "monitor_ui running: $PID"; else echo 'monitor_ui stopped'; exit 1; fi
    ;;
  *) echo 'Usage: S99monitor-ui start|stop|restart|status'; exit 1;;
esac
